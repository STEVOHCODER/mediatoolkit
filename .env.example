# Public site URL used for canonical URLs and metadata
# Local development: http://localhost:3000
# Vercel Production: https://mediatoolkit.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console meta verification content (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Gemini debugging (preferred when configured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin editor
DEVFIXES_ADMIN_TOKEN=
DEVFIXES_LOCAL_PUBLISHING=false
DEVFIXES_CONTENT_DIR=

# Isolated DevFixes Labs execution
E2B_API_KEY=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=devfixes-logs

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=
ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
