# MediaToolkit server configuration
# Copy this file to .env and fill in your own keys from https://www.iloveapi.com console.

# iLoveAPI project keys - keep the secret key server-side ONLY.
ILV_PUBLIC_KEY=project_public_xxxxxxxxxxxxxxxxxxxxxxxx
ILV_SECRET_KEY=secret_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP port for the web app
PORT=3000

# Max upload size in megabytes (per file)
MAX_FILE_MB=100
